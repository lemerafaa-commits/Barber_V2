# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client API Key (saas-barberaria-teste-v1)
VITE_FIREBASE_API_KEY=

# Twilio WhatsApp Configuration (Server-Side Only)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=
# Content SID for Twilio WhatsApp Approved Template (Mandatory for business-initiated WhatsApp messages)
TWILIO_CONTENT_SID=

# Firebase Admin Configuration (Server-Side Only for secure appointment validation)
FIREBASE_PROJECT_ID=saas-barberaria-teste-v1
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or full service account JSON string:
FIREBASE_SERVICE_ACCOUNT=
