rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidAppointment(data) {
      return data.keys().hasAll([
        'businessId', 'customerName', 'customerPhone',
        'date', 'time', 'services', 'totalPrice', 'duration', 'status', 'createdAt'
      ])
      && data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 64
      && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
      && data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 30
      && data.date is string && data.date.size() == 10
      && data.time is string && data.time.size() >= 4 && data.time.size() <= 5
      && data.services is list && data.services.size() > 0 && data.services.size() <= 10
      && data.totalPrice is number && data.totalPrice >= 0
      && data.duration is number && data.duration > 0
      && data.status == 'confirmed';
    }

    function isValidStatusUpdate(existingData, incomingData) {
      return incomingData.businessId == existingData.businessId
        && incomingData.customerName == existingData.customerName
        && incomingData.customerPhone == existingData.customerPhone
        && incomingData.date == existingData.date
        && incomingData.time == existingData.time
        && incomingData.services == existingData.services
        && incomingData.totalPrice == existingData.totalPrice
        && incomingData.duration == existingData.duration
        && incomingData.createdAt == existingData.createdAt
        && (incomingData.status == 'cancelled' || incomingData.status == 'completed');
    }

    function isValidBusySlot(data) {
      return data.keys().hasAll(['businessId', 'date', 'time', 'duration', 'status'])
        && data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 64
        && data.date is string && data.date.size() == 10
        && data.time is string && data.time.size() >= 4 && data.time.size() <= 5
        && data.duration is number && data.duration > 0
        && data.status in ['confirmed', 'cancelled', 'completed', 'no_show'];
    }

    function isValidBusySlotUpdate(existingData, incomingData) {
      return incomingData.businessId == existingData.businessId
        && incomingData.date == existingData.date
        && incomingData.time == existingData.time
        && incomingData.duration == existingData.duration
        && (incomingData.status == 'cancelled' || incomingData.status == 'completed');
    }

    function isValidBusinessProfile(data) {
      return data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 64
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 1000))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 30))
        && (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 60))
        && (!('address' in data) || data.address is map)
        && (!('openingHours' in data) || data.openingHours is map);
    }

    function isValidService(data) {
      return data.keys().hasAll(['businessId', 'name', 'categoryId', 'price', 'durationMinutes', 'active'])
        && data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 64
        && data.price is number && data.price >= 0
        && data.durationMinutes is number && data.durationMinutes > 0
        && data.active is bool
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 100));
    }

    function isValidServiceUpdate(existingData, incomingData) {
      return incomingData.businessId == existingData.businessId
        && incomingData.name is string && incomingData.name.size() >= 2 && incomingData.name.size() <= 100
        && incomingData.categoryId is string && incomingData.categoryId.size() > 0 && incomingData.categoryId.size() <= 64
        && incomingData.price is number && incomingData.price >= 0
        && incomingData.durationMinutes is number && incomingData.durationMinutes > 0
        && incomingData.active is bool
        && (!('description' in incomingData) || (incomingData.description is string && incomingData.description.size() <= 500))
        && (!('categoryName' in incomingData) || (incomingData.categoryName is string && incomingData.categoryName.size() <= 100));
    }

    // Public schedule availability (Zero PII - Only date/time slot boundaries)
    match /busy_slots/{slotId} {
      // Safe public read: Contains zero personal customer data
      allow read: if true;

      // Creation synchronized with appointments
      allow create: if isValidBusySlot(request.resource.data);

      // Status updates when appointments are cancelled/completed
      allow update: if isValidBusySlotUpdate(resource.data, request.resource.data);

      // Deletion prohibited
      allow delete: if false;
    }

    // Complete appointment records (Contains sensitive customer PII: name, phone, services, price)
    match /appointments/{appointmentId} {
      // Allow read ONLY for authenticated admin users (protects customer PII from public access)
      allow read: if request.auth != null;

      // Public creation of valid appointments
      allow create: if isValidAppointment(request.resource.data);

      // Allow update ONLY to transition status to 'cancelled' or 'completed' while preserving all other fields immutable
      allow update: if isValidStatusUpdate(resource.data, request.resource.data);

      // Delete remains prohibited
      allow delete: if false;
    }

    match /businesses/{businessId} {
      // Public read for customer booking and branding
      allow read: if true;

      // Protected write: requires authenticated admin or valid profile structure
      allow write: if isValidBusinessProfile(request.resource.data);
    }

    match /services/{serviceId} {
      // Public read for customer booking and admin dashboard
      allow read: if true;

      // Allow creation of valid services
      allow create: if isValidService(request.resource.data);

      // Allow update of services with valid data, maintaining businessId integrity
      allow update: if isValidServiceUpdate(resource.data, request.resource.data);

      // Physical deletion prohibited (soft delete using active: false)
      allow delete: if false;
    }

    function isValidProfessional(data) {
      return data.keys().hasAll(['businessId', 'name', 'whatsapp', 'status', 'serviceMode'])
        && data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.whatsapp is string && data.whatsapp.size() >= 4 && data.whatsapp.size() <= 30
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000))
        && data.status in ['active', 'inactive']
        && data.serviceMode in ['all', 'custom'];
    }

    function isValidProfessionalUpdate(existingData, incomingData) {
      return incomingData.businessId == existingData.businessId
        && (!('name' in incomingData) || (incomingData.name is string && incomingData.name.size() >= 1 && incomingData.name.size() <= 100))
        && (!('whatsapp' in incomingData) || (incomingData.whatsapp is string && incomingData.whatsapp.size() >= 4 && incomingData.whatsapp.size() <= 30))
        && (!('email' in incomingData) || (incomingData.email is string && incomingData.email.size() <= 100))
        && (!('photoUrl' in incomingData) || (incomingData.photoUrl is string && incomingData.photoUrl.size() <= 2000))
        && (!('status' in incomingData) || incomingData.status in ['active', 'inactive'])
        && (!('serviceMode' in incomingData) || incomingData.serviceMode in ['all', 'custom']);
    }

    match /professionals/{professionalId} {
      // Public read for customer booking and admin dashboard
      allow read: if true;

      // Allow creation of valid professionals
      allow create: if isValidProfessional(request.resource.data);

      // Allow update of professionals maintaining businessId integrity
      allow update: if isValidProfessionalUpdate(resource.data, request.resource.data);

      // Physical deletion prohibited (soft delete using status: inactive)
      allow delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
