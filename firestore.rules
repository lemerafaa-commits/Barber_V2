rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS: AUTENTICAÇÃO E ISOLAMENTO MULTIEMPRESA (JOBSNIAK V5)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMaster() {
      return isAuthenticated()
        && ('master' in request.auth.token && request.auth.token.master == true);
    }

    function isAdminForBusiness(targetBusinessId) {
      return isAuthenticated() && (
        isMaster() || (
          'role' in request.auth.token && request.auth.token.role == 'admin' &&
          'businessId' in request.auth.token && request.auth.token.businessId == targetBusinessId
        )
      );
    }

    // =========================================================================
    // HELPER FUNCTIONS: VALIDAÇÃO ESTRUTURAL DE DOCUMENTOS
    // =========================================================================

    function isValidBusinessProfile(data) {
      return data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 64
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 1000))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 30))
        && (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 60))
        && (!('address' in data) || data.address is map)
        && (!('openingHours' in data) || data.openingHours is map);
    }

    function isValidService(data) {
      return data.keys().hasAll(['businessId', 'name', 'categoryId', 'price', 'durationMinutes', 'active'])
        && data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 64
        && data.price is number && data.price >= 0
        && data.durationMinutes is number && data.durationMinutes > 0
        && data.active is bool
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 100));
    }

    function isValidServiceUpdate(existingData, incomingData) {
      return incomingData.businessId == existingData.businessId
        && incomingData.name is string && incomingData.name.size() >= 2 && incomingData.name.size() <= 100
        && incomingData.categoryId is string && incomingData.categoryId.size() > 0 && incomingData.categoryId.size() <= 64
        && incomingData.price is number && incomingData.price >= 0
        && incomingData.durationMinutes is number && incomingData.durationMinutes > 0
        && incomingData.active is bool
        && (!('description' in incomingData) || (incomingData.description is string && incomingData.description.size() <= 500))
        && (!('categoryName' in incomingData) || (incomingData.categoryName is string && incomingData.categoryName.size() <= 100));
    }

    function isValidProfessional(data) {
      return data.keys().hasAll(['businessId', 'name', 'whatsapp', 'status', 'serviceMode'])
        && data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.whatsapp is string && data.whatsapp.size() >= 4 && data.whatsapp.size() <= 30
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000))
        && data.status in ['active', 'inactive']
        && data.serviceMode in ['all', 'custom'];
    }

    function isValidProfessionalUpdate(existingData, incomingData) {
      return incomingData.businessId == existingData.businessId
        && (!('name' in incomingData) || (incomingData.name is string && incomingData.name.size() >= 1 && incomingData.name.size() <= 100))
        && (!('whatsapp' in incomingData) || (incomingData.whatsapp is string && incomingData.whatsapp.size() >= 4 && incomingData.whatsapp.size() <= 30))
        && (!('email' in incomingData) || (incomingData.email is string && incomingData.email.size() <= 100))
        && (!('photoUrl' in incomingData) || (incomingData.photoUrl is string && incomingData.photoUrl.size() <= 2000))
        && (!('status' in incomingData) || incomingData.status in ['active', 'inactive'])
        && (!('serviceMode' in incomingData) || incomingData.serviceMode in ['all', 'custom']);
    }

    // =========================================================================
    // COLEÇÃO: busy_slots (Grade de Disponibilidade Anônima - Zero PII)
    // =========================================================================
    match /busy_slots/{slotId} {
      // Leitura pública necessária para cálculo dinâmico de horários livres no fluxo de agendamento
      allow read: if true;

      // Criação direta pelo cliente proibida (gerenciada exclusivamente pelo backend transacional)
      allow create: if false;

      // Atualização permitida apenas para o administrador autorizado da empresa ou Master,
      // exclusivamente na conclusão atômica do atendimento ('confirmed' -> 'completed')
      allow update: if isAdminForBusiness(resource.data.businessId)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'completed';

      // Exclusão física proibida
      allow delete: if false;
    }

    // =========================================================================
    // COLEÇÃO: appointments (Registros Completos com Dados Pessoais do Cliente)
    // =========================================================================
    match /appointments/{appointmentId} {
      // Leitura restrita exclusivamente ao administrador autorizado da respectiva empresa ou Master
      allow read: if isAdminForBusiness(resource.data.businessId);

      // Criação direta pelo cliente estritamente proibida (criação via /api/bookings/create)
      allow create: if false;

      // Atualização permitida exclusivamente para o administrador da empresa ou Master
      // registrar a conclusão do atendimento ('confirmed' -> 'completed'),
      // garantindo que nenhum dado do cliente ou de negócio seja alterado
      allow update: if isAdminForBusiness(resource.data.businessId)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'completed';

      // Exclusão física proibida
      allow delete: if false;
    }

    // =========================================================================
    // COLEÇÃO: businesses (Perfil e Identidade da Barbearia)
    // =========================================================================
    match /businesses/{businessId} {
      // Leitura pública permitida para apresentação do estabelecimento e horários
      allow read: if true;

      // Gravação restrita exclusivamente ao administrador autenticado da empresa ou Master
      allow create, update: if isAdminForBusiness(businessId)
        && request.resource.data.businessId == businessId
        && isValidBusinessProfile(request.resource.data);

      // Exclusão física proibida
      allow delete: if false;
    }

    // =========================================================================
    // COLEÇÃO: services (Catálogo de Serviços)
    // =========================================================================
    match /services/{serviceId} {
      // Leitura pública permitida para consulta do menu de serviços
      allow read: if true;

      // Criação restrita ao administrador da empresa indicada no documento ou Master
      allow create: if isAdminForBusiness(request.resource.data.businessId)
        && isValidService(request.resource.data);

      // Atualização restrita ao administrador da empresa ou Master, mantendo businessId imutável
      allow update: if isAdminForBusiness(resource.data.businessId)
        && isValidServiceUpdate(resource.data, request.resource.data);

      // Exclusão física proibida (soft-delete via active: false)
      allow delete: if false;
    }

    // =========================================================================
    // COLEÇÃO: professionals (Equipe e Profissionais)
    // =========================================================================
    match /professionals/{professionalId} {
      // Leitura restrita ao administrador autenticado da empresa titular ou Master
      allow read: if isAdminForBusiness(resource.data.businessId);

      // Criação restrita ao administrador da empresa informada ou Master
      allow create: if isAdminForBusiness(request.resource.data.businessId)
        && isValidProfessional(request.resource.data);

      // Atualização restrita ao administrador da empresa ou Master, mantendo businessId imutável
      allow update: if isAdminForBusiness(resource.data.businessId)
        && isValidProfessionalUpdate(resource.data, request.resource.data);

      // Exclusão física proibida (soft-delete via status: 'inactive')
      allow delete: if false;
    }

    // =========================================================================
    // BLOQUEIO GLOBAL PADRÃO (DEFAULT DENY)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
